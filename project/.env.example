# Next.js Configuration
# Copy this file to .env.local and fill in your values
# Run: cp .env.example .env.local

# ============================================
# CLERK AUTHENTICATION (Task 2.1)
# ============================================
# Get your keys from https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_secret_here

# Clerk URLs (update these after deploying)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/sync
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/sync

# ============================================
# APP
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# DATABASE (Neon Postgres)
# ============================================
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ============================================
# RESEND (invitation emails)
# ============================================
RESEND_API_KEY=re_your_key_here

# ============================================
# PUSHER (realtime notifications)
# ============================================
# Get your credentials from https://dashboard.pusher.com
NEXT_PUBLIC_PUSHER_APP_ID=your_app_id_here
NEXT_PUBLIC_PUSHER_PUBLISHER_KEY=your_key_here
PUSHER_SECRET_KEY=your_secret_here
NEXT_PUBLIC_PUSHER_CLUSTER=ap1

# ============================================
# UPLOADTHING (task attachments)
# ============================================
# v7 reads a single token. Get it from https://uploadthing.com/dashboard
# The older UPLOADTHING_SECRET / UPLOADTHING_APP_ID pair is v6 and is ignored.
UPLOADTHING_TOKEN=your_token_here

# ============================================
# E2E TESTING (Playwright)
# ============================================
# Clerk test-mode accounts. The +clerk_test suffix makes Clerk accept the
# fixed verification code below instead of sending a real email.
# TEST ACCOUNT #1 - the first-run account; globalSetup wipes its workspaces
# before every run so the onboarding journey is repeatable.
E2E_USER_EMAIL=test1+clerk_test@example.com
E2E_USER_PASSWORD=your_test_password_here

# TEST ACCOUNT #2 - reserved for specs that need an already-onboarded user.
E2E_ONBOARDING_USER_EMAIL=test2+clerk_test@example.com
E2E_ONBOARDING_USER_PASSWORD=your_test_password_here

E2E_VERIFICATION_CODE=424242